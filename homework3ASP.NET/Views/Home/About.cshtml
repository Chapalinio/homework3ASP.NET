@{
    ViewData["Title"] = "Про нас - Space Rig Bar";
}

<style>
    /* Базові стилі та шрифти */
    @@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Share+Tech+Mono&display=swap');

    :root {
        --bg-dark: #0b0e14;
        --card-bg: #161b26;
        --gold: #ffb700;
        --morkite: #00ffd5;
        --text: #e2e8f0;
        --text-dim: #8b9bb4;
        --border-color: #2a3447;
    }

    body {
        margin: 0;
        padding: 0;
        background-color: var(--bg-dark);
        color: var(--text);
        font-family: 'Share Tech Mono', monospace;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    /* Навігація */
    .drg-nav {
        background: #111520;
        border-bottom: 2px solid var(--gold);
        padding: 1rem 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 4px 20px rgba(0,0,0,0.5);
    }

    .brand {
        font-family: 'Orbitron', sans-serif;
        font-weight: 900;
        font-size: 1.4rem;
        color: var(--gold);
        letter-spacing: 2px;
        text-shadow: 0 0 10px rgba(255, 183, 0, 0.4);
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .nav-links {
        display: flex;
        gap: 15px;
    }

    .nav-btn {
        font-family: 'Orbitron', sans-serif;
        color: var(--text);
        text-decoration: none;
        padding: 10px 20px;
        border: 1px solid var(--border-color);
        background: var(--card-bg);
        transition: all 0.2s ease;
        text-transform: uppercase;
        font-size: 0.9rem;
        letter-spacing: 1px;
    }

        .nav-btn:hover {
            border-color: var(--gold);
            color: var(--gold);
            box-shadow: 0 0 12px rgba(255, 183, 0, 0.3);
            transform: translateY(-2px);
        }

        .nav-btn.active {
            background: var(--gold);
            color: #000;
            font-weight: bold;
        }

    /* Контейнер сторінки */
    .about-container {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2.5rem 1.5rem;
    }

    .about-card {
        position: relative;
        background: var(--card-bg);
        border: 2px solid var(--gold);
        max-width: 850px;
        width: 100%;
        box-shadow: 0 0 35px rgba(0,0,0,0.9), inset 0 0 15px rgba(255, 183, 0, 0.1);
        padding: 3rem 2.5rem;
    }

        .about-card::before {
            content: 'CORPORATE DOSSIER // DEEP ROCK GALACTIC';
            position: absolute;
            top: -12px;
            left: 20px;
            background: var(--gold);
            color: #000;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.75rem;
            font-weight: bold;
            padding: 2px 10px;
        }

    .about-header {
        text-align: center;
        margin-bottom: 2.5rem;
    }

    .about-title {
        font-family: 'Orbitron', sans-serif;
        font-size: 2.2rem;
        color: #fff;
        margin: 0 0 0.5rem 0;
        text-transform: uppercase;
        letter-spacing: 2px;
    }

    .about-subtitle {
        color: var(--morkite);
        font-size: 1rem;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    /* Сетка інфо-блоків */
    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 20px;
        margin-bottom: 2.5rem;
    }

    .info-box {
        background: rgba(11, 14, 20, 0.6);
        border: 1px solid var(--border-color);
        padding: 1.5rem;
        position: relative;
        transition: border-color 0.2s ease;
    }

        .info-box:hover {
            border-color: var(--gold);
        }

    .info-box-title {
        font-family: 'Orbitron', sans-serif;
        color: var(--gold);
        font-size: 1.1rem;
        margin-top: 0;
        margin-bottom: 0.8rem;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .info-box p {
        color: var(--text-dim);
        font-size: 0.95rem;
        line-height: 1.5;
        margin: 0;
    }

    /* Футер картки */
    .about-footer {
        border-top: 1px dashed var(--border-color);
        padding-top: 1.5rem;
        text-align: center;
    }

    .quote-text {
        font-style: italic;
        color: var(--text);
        font-size: 1.05rem;
        margin-bottom: 1rem;
    }

    .rock-and-stone {
        font-family: 'Orbitron', sans-serif;
        font-size: 1.3rem;
        color: var(--gold);
        font-weight: 900;
        text-shadow: 0 0 10px rgba(255, 183, 0, 0.5);
    }

    @@media (max-width: 650px) {
        .drg-nav {
            flex-direction: column;
            gap: 15px;
        }

        .about-title {
            font-size: 1.6rem;
        }

        .about-card {
            padding: 2rem 1.5rem;
        }
    }
</style>

<!-- Навігація -->
<nav class="drg-nav">
    <div class="brand">
        ⛏️ SPACE RIG BAR
    </div>
    <div class="nav-links">
        <a href="https://localhost:7086/Home/Index" class="nav-btn">Головна</a>
        <a href="https://localhost:7086/Home/About" class="nav-btn active">Про нас</a>
        <a href="https://localhost:7086/Product/Index" class="nav-btn">Каталог пива</a>
    </div>
</nav>

<!-- Контент сторінки Про нас -->
<main class="about-container">
    <div class="about-card">
        <div class="about-header">
            <h1 class="about-title">Про наш Бар</h1>
            <div class="about-subtitle">// Офіційна зона відпочинку Space Rig 17</div>
        </div>

        <div class="info-grid">
            <div class="info-box">
                <h3 class="info-box-title">🤖 Бармен Ллойд</h3>
                <p>
                    Наш вірний робот-бармен завжди готовий налити найхолодніший кухоль пива. Всі замовлення обробляються миттєво!
                </p>
            </div>

            <div class="info-box">
                <h3 class="info-box-title">🚀 Локація</h3>
                <p>
                    Бар розташований на орбітальній станції Space Rig 17 безпосередньо над найнебезпечнішою планетою галактики — Хокссес IV.
                </p>
            </div>

            <div class="info-box">
                <h3 class="info-box-title">🍺 Наша Місія</h3>
                <p>
                    Забезпечити кожного шахтаря міцним напоєм перед важким вильотом або для святкування успішного видобутку ресурсів.
                </p>
            </div>
        </div>

        <div class="about-footer">
            <p class="quote-text">«Якщо ти не п'єш пиво після видобутку мортиту — ти ельф!»</p>
            <div class="rock-and-stone">FOR ROCK AND STONE! ⛏️</div>
        </div>
    </div>
</main>