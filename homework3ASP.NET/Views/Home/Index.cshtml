@{
    ViewData["Title"] = "Головна - Space Rig Bar";
}

<style>
    /* Базові стилі та імпорт футуристичних шрифтів */
    @@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Share+Tech+Mono&display=swap');

    :root {
        --bg-dark: #0b0e14;
        --card-bg: #161b26;
        --gold: #ffb700;
        --text: #e2e8f0;
        --text-dim: #8b9bb4;
        --border-color: #2a3447;
    }

    body {
        margin: 0;
        padding: 0;
        background-color: var(--bg-dark);
        color: var(--text);
        font-family: 'Share Tech Mono', monospace;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    /* Навігація */
    .drg-nav {
        background: #111520;
        border-bottom: 2px solid var(--gold);
        padding: 1rem 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 4px 20px rgba(0,0,0,0.5);
    }

    .brand {
        font-family: 'Orbitron', sans-serif;
        font-weight: 900;
        font-size: 1.4rem;
        color: var(--gold);
        letter-spacing: 2px;
        text-shadow: 0 0 10px rgba(255, 183, 0, 0.4);
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .nav-links {
        display: flex;
        gap: 15px;
    }

    .nav-btn {
        font-family: 'Orbitron', sans-serif;
        color: var(--text);
        text-decoration: none;
        padding: 10px 20px;
        border: 1px solid var(--border-color);
        background: var(--card-bg);
        transition: all 0.2s ease;
        text-transform: uppercase;
        font-size: 0.9rem;
        letter-spacing: 1px;
    }

        .nav-btn:hover {
            border-color: var(--gold);
            color: var(--gold);
            box-shadow: 0 0 12px rgba(255, 183, 0, 0.3);
            transform: translateY(-2px);
        }

        .nav-btn.active {
            background: var(--gold);
            color: #000;
            font-weight: bold;
        }

    /* Контейнер головної сторінки */
    .hero-container {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2.5rem 1.5rem;
        position: relative;
    }

    /* Адаптивна картка вітання */
    .hero-card {
        position: relative;
        background: var(--card-bg);
        border: 2px solid var(--gold);
        max-width: 800px;
        width: 100%;
        overflow: hidden;
        box-shadow: 0 0 35px rgba(0,0,0,0.9), inset 0 0 15px rgba(255, 183, 0, 0.1);
    }

        .hero-card::before {
            content: 'DRG-TERMINAL // SPACE RIG 17';
            position: absolute;
            top: 0;
            left: 0;
            background: var(--gold);
            color: #000;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.75rem;
            font-weight: bold;
            padding: 4px 12px;
            z-index: 2;
        }

    /* Контейнер із зображенням */
    .hero-image-wrapper {
        position: relative;
        width: 100%;
        height: 320px;
        overflow: hidden;
        border-bottom: 2px solid var(--border-color);
    }

    .hero-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: brightness(0.85) contrast(1.1);
        transition: transform 0.5s ease;
    }

    .hero-card:hover .hero-image {
        transform: scale(1.03);
    }

    /* Текстовий блок */
    .hero-content {
        padding: 2.5rem;
        text-align: center;
    }

    .hero-title {
        font-family: 'Orbitron', sans-serif;
        font-size: 2.2rem;
        color: #fff;
        margin-top: 0;
        margin-bottom: 1rem;
        text-transform: uppercase;
        letter-spacing: 2px;
    }

    .hero-subtitle {
        color: var(--text-dim);
        font-size: 1.15rem;
        line-height: 1.6;
        margin-bottom: 1.8rem;
    }

    .rock-and-stone {
        font-family: 'Orbitron', sans-serif;
        font-size: 1.5rem;
        color: var(--gold);
        font-weight: 900;
        text-shadow: 0 0 12px rgba(255, 183, 0, 0.6);
        animation: pulse 2s infinite alternate;
        margin: 0;
    }

    @@keyframes pulse {
        0% {
            opacity: 0.75;
            transform: scale(0.98);
        }

        100% {
            opacity: 1;
            transform: scale(1.02);
        }
    }

    @@media (max-width: 650px) {
        .drg-nav {
            flex-direction: column;
            gap: 15px;
        }

        .hero-title {
            font-size: 1.6rem;
        }

        .hero-image-wrapper {
            height: 200px;
        }

        .hero-content {
            padding: 1.5rem;
        }
    }
</style>

<!-- Навігація -->
<nav class="drg-nav">
    <div class="brand">
        ⛏️ SPACE RIG BAR
    </div>
    <div class="nav-links">
        <a href="https://localhost:7086/Home/Index" class="nav-btn active">Головна</a>
        <a href="https://localhost:7086/Home/About" class="nav-btn">Про нас</a>
        <a href="https://localhost:7086/Product/Index" class="nav-btn">Каталог пива</a>
    </div>
</nav>

<!-- Привітальна картка -->
<main class="hero-container">
    <div class="hero-card">
        <div class="hero-image-wrapper">
            <img src="https://images.steamusercontent.com/ugc/1788514823475841129/A9FDC7DA19CC57D1C3391A872F3D2CA96114A95C/?imw=637&imh=358&ima=fit&impolicy=Letterbox&imcolor=%23000000&letterbox=true"
                 alt="Deep Rock Galactic Dwarves"
                 class="hero-image" />
        </div>

        <div class="hero-content">
            <h1 class="hero-title">Ласкаво просимо до Бару Ллойда!</h1>
            <p class="hero-subtitle">
                Вітаємо на космічній станції Space Rig. Тут гноми відпочивають після важких вильотів у печери Хокссеса.
                Обирай холодний кухоль у меню зверху та готуйся до наступної місії!
            </p>

            <div class="rock-and-stone">
                ROCK AND STONE, DWARF! ⛏️
            </div>
        </div>
    </div>
</main>